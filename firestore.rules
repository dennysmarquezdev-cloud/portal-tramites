rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: checks if user is authenticated via Google
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: checks if user has 'esAdmin: true' in the compradores collection or is the owner admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'plaeis260@gmail.com' ||
        (exists(/databases/$(database)/documents/compradores/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/compradores/$(request.auth.token.email.lower())).data.esAdmin == true)
      );
    }

    // Buyers collection (Google Sign-In authorization checklist)
    match /compradores/{email} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.token.email.lower() == email &&
        request.resource.data.isPremium == false &&
        request.resource.data.esAdmin == false
      );
      allow update, delete: if isAdmin();
    }

    // User's own favorites collection
    match /favoritos/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // User's own activity collection
    match /actividad/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Categories collection
    match /categorias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Procedures collection
    match /tramites/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses collection
    match /cursos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config collection (site configuration)
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Express collection (quick access bar)
    match /express/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Radar de Trámites (Zyte Scraper)
    match /tramites_descubiertos/{id} {
      allow read, write: if isAdmin();
    }
  }
}
